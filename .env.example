# Local development settings. Replace credentials in deployed environments.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=referral_analytics
POSTGRES_USER=referral
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://referral:local-development-only@postgres:5432/referral_analytics
REDIS_URL=redis://redis:6379/0
# Set a distinct namespace for each deployment sharing Redis. Zero TTL disables report caching.
ANALYTICS_CACHE_NAMESPACE=referral-analytics
ANALYTICS_CACHE_TTL_SECONDS=60
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/1
OUTBOX_DRAIN_SECONDS=20

# Generate a unique random secret for each deployment; never commit the real value.
JWT_SECRET=local-development-only-change-this-jwt-secret-before-deployment
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Optional Docker Compose monitoring profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-monitoring-only
