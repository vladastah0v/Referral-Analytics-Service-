{
  "uid": "referral-analytics",
  "title": "Referral Analytics Service",
  "tags": [
    "referral-analytics"
  ],
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "up{job=~\"referral-api|referral-worker\"}",
          "legendFormat": "{{job}} \u00b7 {{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "sum by (method, route) (rate(referral_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "(sum(rate(referral_http_errors_total[$__rate_interval])) or vector(0)) / sum(rate(referral_http_requests_total[$__rate_interval]))",
          "legendFormat": "4xx + 5xx",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(referral_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL query latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job, outcome) (rate(referral_db_query_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{job}} \u00b7 {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Celery attempt duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, task, outcome) (rate(referral_celery_task_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{task}} \u00b7 {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Celery terminal failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "sum by (task) (increase(referral_celery_task_failures_total[$__rate_interval]))",
          "legendFormat": "{{task}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Outbox terminal events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "sum by (event_type, outcome) (rate(referral_events_processed_total[$__rate_interval]))",
          "legendFormat": "{{event_type}} \u00b7 {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Duplicate deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "sum by (stage) (rate(referral_duplicate_events_total[$__rate_interval]))",
          "legendFormat": "{{stage}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Outbox pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "max(referral_outbox_pending)",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Oldest pending outbox event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "max(referral_outbox_oldest_pending_seconds)",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Failed event submissions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "referral-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "referral-prometheus"
          },
          "expr": "sum by (mode, status) (rate(referral_event_ingestion_failures_total[$__rate_interval]))",
          "range": true
        }
      ]
    }
  ]
}
